# ── Rotaract Igualada — configuracions d'Apache ──

# Seguretat bàsica del servidor
Options -Indexes
ServerSignature Off

# HTTPS obligatori (CANVIA el domini pel real abans de publicar)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.rotaractigualada.org/$1 [R=301,L]

# Redirecció de la pàgina antiga (SEO / enllaços ja indexats)
Redirect 301 /rotaractigualada.html /index.html

# ── Capçaleres de seguretat ──
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: només té efecte quan el lloc es serveix per HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  # style-src 'unsafe-inline' és necessari pels estils inline propis
  # (bloc <style> de directiu.html i atributs style=); cap script inline.
  # instagram.com només per als posts incrustats de la secció d'Instagram
  # (script d'incrustació oficial + iframes de cada post).
  # jotform.com per al formulari d'inscripció (script d'incrustació + iframe).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.instagram.com https://*.jotform.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.jotform.com; object-src 'none'; frame-src https://www.instagram.com https://instagram.com https://*.jotform.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# ── Bloqueig de fitxers sensibles ──
<FilesMatch "^(\.env|\.git|composer\.json|package\.json|\.htpasswd)|\.(log|sql|csv|bak|old|tmp|swp)$">
  Require all denied
</FilesMatch>

# ── Compressió ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
