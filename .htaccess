# ── Rotaract Igualada — configuracions d'Apache ──

# Pàgina d'inici de cada carpeta
DirectoryIndex index.html

# Seguretat bàsica: no mostrar el llistat de fitxers de les carpetes
Options -Indexes

# HTTPS obligatori. Manté el domini amb què s'accedeix (%{HTTP_HOST}).
# La segona condició evita bucles darrere del CDN de Hostinger, que
# rep la visita per HTTPS i l'envia al servidor indicant-ho amb
# la capçalera X-Forwarded-Proto.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Una sola adreça per a Google: www.rotaractigualada.org → rotaractigualada.org
# (la mateixa del sitemap i de les etiquetes canonical)
RewriteCond %{HTTP_HOST} ^www\.rotaractigualada\.org$ [NC]
RewriteRule ^ https://rotaractigualada.org%{REQUEST_URI} [R=301,L]

# Redirecció de la pàgina antiga (SEO / enllaços ja indexats)
Redirect 301 /rotaractigualada.html /index.html

# ── Capçaleres de seguretat ──
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: només té efecte quan el lloc es serveix per HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Aísla les finestres (open) i els recursos propis d'ús creuat.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # No revelis la versió de PHP del servidor
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=(), display-capture=(), serial=(), bluetooth=(), hid=()"
  # style-src 'unsafe-inline' és necessari pels estils inline propis
  # (atributs style= de l'HTML); cap script inline.
  # goatcounter: estadístiques de visites sense cookies (analytics.js).
  # tile.openstreetmap.org: el mapa d'Igualada de Nosaltres, només si es demana.
  # form-action 'self': els formularis de Contacte només s'envien a la
  # mateixa web (form-handler.php).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://rotaractigualada.goatcounter.com https://tile.openstreetmap.org; connect-src 'self'; media-src 'self'; manifest-src 'self'; worker-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# ── Logo dels correus ──
# Els correus del formulari i les plantilles de resposta el mostren des
# d'un altre domini (Gmail, Outlook…). Amb «same-origin» el navegador no
# el deixa carregar mentre s'escriu el correu, així que aquest fitxer, i
# només aquest, es pot fer servir des de fora.
<Files "logo-correu.png">
  <IfModule mod_headers.c>
    Header always set Cross-Origin-Resource-Policy "cross-origin"
  </IfModule>
</Files>

# ── Bloqueig de fitxers sensibles ──
<FilesMatch "^(\.env|\.git|composer\.json|package\.json|package-lock\.json|\.htpasswd)|\.(log|sql|csv|bak|old|tmp|swp|mjs)$">
  Require all denied
</FilesMatch>

# ── PHP: només s'executen form-handler.php (els formularis de Contacte)
# i instagram-feed.php (les últimes publicacions d'Instagram de la portada) ──
# Qualsevol altre fitxer PHP o script queda bloquejat (protegeix contra
# fitxers maliciosos que algú hi pogués pujar).
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(form-handler|instagram-feed)\.php$">
  Require all granted
</FilesMatch>

# Fitxers i carpetes ocults (.git, .env…): no existeixen per web,
# excepte .well-known (security.txt i verificacions de domini)
RedirectMatch 404 /\.(?!well-known(/|$))

# ── Protecció del directori de dades dels formularis ──
# Tot el directori form-data/ (CSV de trameses i fitxers de límit
# d'enviaments) queda inaccessible per web, sigui quina sigui l'extensió.
RedirectMatch 404 ^/form-data(/|$)
# Tests i dependències de desenvolupament: no s'han de servir
RedirectMatch 404 ^/(tests|node_modules)(/|$)

# El fitxer submissions.csv conté dades personals dels usuaris;
# no s'ha de poder descarregar per web en cap cas.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(csv|txt|log|json)$">
    Require all denied
  </FilesMatch>
  # Excepció: robots.txt ha de ser públic perquè els cercadors el llegeixin
  # (la regla anterior el bloquejava amb un 403).
  <Files "robots.txt">
    Require all granted
  </Files>
  # Excepció: security.txt (com informar de problemes de seguretat)
  <Files "security.txt">
    Require all granted
  </Files>
  # Excepció: dades públiques de la web (límits dels municipis del mapa,
  # activitats del club i grups de treball), que la mateixa web llegeix
  <FilesMatch "^(anoia|projectes|grups)\.json$">
    Require all granted
  </FilesMatch>
</IfModule>

# ── Compressió ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript text/javascript image/svg+xml
</IfModule>

# Tipus MIME del manifest i de les icones
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
  AddType font/woff2 .woff2
</IfModule>

# ── Memòria cau del navegador ──
# Imatges i icones canvien poc: 30 dies. Les tipografies no canvien: 1 any. Els CSS i JS es carreguen amb
# una versió (?v=hash, la posa npm run build:idiomes) que canvia quan
# canvia el fitxer: es poden desar 1 any. L'HTML no es desa a la memòria cau.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
