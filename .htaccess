# ── Rotaract Igualada — configuracions d'Apache ──

# Pàgina d'inici de cada carpeta
DirectoryIndex index.html index.php

# Seguretat bàsica: no mostrar el llistat de fitxers de les carpetes
Options -Indexes

# HTTPS obligatori. Manté el domini amb què s'accedeix (%{HTTP_HOST}).
# La segona condició evita bucles darrere del CDN de Hostinger, que
# rep la visita per HTTPS i l'envia al servidor indicant-ho amb
# la capçalera X-Forwarded-Proto.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Redirecció de la pàgina antiga (SEO / enllaços ja indexats)
Redirect 301 /rotaractigualada.html /index.html

# ── Capçaleres de seguretat ──
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: només té efecte quan el lloc es serveix per HTTPS
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Aísla les finestres (open) i els recursos propis d'ús creuat.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  # No revelis la versió de PHP del servidor
  Header always unset X-Powered-By
  Header unset X-Powered-By
  # El formulari d'inscripció (JotForm) pot demanar càmera/micròfon
  # (atribut allow de l'embed); es permet només per als iframes de jotform.com.
  Header always set Permissions-Policy "geolocation=(), camera=(self \"https://*.jotform.com\"), microphone=(self \"https://*.jotform.com\"), payment=(), usb=(), magnetometer=(), gyroscope=()"
  # style-src 'unsafe-inline' és necessari pels estils inline propis
  # (atributs style= de l'HTML i dels embeds); cap script inline.
  # instagram.com només per als posts incrustats de la secció d'Instagram
  # (script d'incrustació oficial + iframes de cada post).
  # jotform.com per al formulari d'inscripció (script d'incrustació + iframe).
  # google-analytics / googletagmanager: només si l'usuari accepta les
  # cookies d'anàlisi (analytics.js no les carrega si no hi ha consentiment).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.instagram.com https://*.jotform.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://*.jotform.com https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com; object-src 'none'; frame-src https://www.instagram.com https://instagram.com https://*.jotform.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# ── Bloqueig de fitxers sensibles ──
<FilesMatch "^(\.env|\.git|composer\.json|package\.json|package-lock\.json|\.htpasswd)|\.(log|sql|csv|bak|old|tmp|swp|mjs)$">
  Require all denied
</FilesMatch>

# ── Protecció del directori de dades del formulari ──
# Tot el directori form-data/ (CSV de trameses i fitxers de límit
# d'enviaments) queda inaccessible per web, sigui quina sigui l'extensió.
RedirectMatch 404 ^/form-data(/|$)
# Tests i dependències de desenvolupament: no s'han de servir
RedirectMatch 404 ^/(tests|node_modules)(/|$)

# El fitxer submissions.csv conté dades personals dels usuaris;
# no s'ha de poder descarregar per web en cap cas.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(csv|txt|log|json)$">
    Require all denied
  </FilesMatch>
  # Excepció: robots.txt ha de ser públic perquè els cercadors el llegeixin
  # (la regla anterior el bloquejava amb un 403).
  <Files "robots.txt">
    Require all granted
  </Files>
</IfModule>

# ── Compressió ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript text/javascript image/svg+xml
</IfModule>

# ── Memòria cau del navegador ──
# Imatges i icones canvien poc: 30 dies. CSS i JS no porten versió al
# nom del fitxer, així que es mantenen curts (1 dia) perquè els canvis
# publicats arribin aviat. L'HTML no es desa a la memòria cau.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
